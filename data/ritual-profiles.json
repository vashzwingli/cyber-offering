[
  {
    "id": "dao-jiao-classical",
    "label": "黄箓醮仪摘要",
    "note": "据传统道教斋醮文本抽取“发炉降神—三献—送神复炉”的主干；这是典籍展示，不冒充任何宫观的现行科仪。",
    "sources": [
      {
        "title": "《无上黄箓大斋立成仪·醮说》",
        "locator": "卷十五：发炉降神、一献上香、读词再献、三献送神复炉；茶果酒馔随力丰俭",
        "url": "https://zh.wikisource.org/zh-hans/%E7%84%A1%E4%B8%8A%E9%BB%83%E7%B1%99%E5%A4%A7%E9%BD%8B%E7%AB%8B%E6%88%90%E5%84%80/15"
      },
      {
        "title": "《正一威仪经》",
        "locator": "烧香威仪、然灯威仪：整治香具、每当三献、行香与然灯",
        "url": "https://zh.wikisource.org/zh-hans/%E6%AD%A3%E4%B8%80%E5%A8%81%E5%84%80%E7%B6%93"
      }
    ],
    "steps": [
      {
        "id": "purify",
        "label": "澡洁正衣",
        "note": "典籍先强调洁净坛场、香具与衣冠，再进入行礼。",
        "kind": "reverence",
        "icon": "hand",
        "display_note": "净身整衣，洁净坛场与香具。",
        "scene": {
          "enabled": false,
          "reason": "洁身正衣与洁坛场，不是供桌上的独立物件。"
        }
      },
      {
        "id": "invoke",
        "label": "发炉降神",
        "note": "启坛奉请，表明所告之事与奉祀对象。",
        "kind": "lamp",
        "icon": "lamp",
        "display_note": "启坛奉请，陈明所告之事。",
        "scene": {
          "enabled": false,
          "reason": "启坛奉请不能用台灯或推测的供物代替。"
        }
      },
      {
        "id": "first-offering",
        "label": "一献上香",
        "note": "《醮说》所列第一献；《正一威仪经》亦记三献续香。",
        "kind": "incense",
        "icon": "flame",
        "display_note": "奉香行礼，行第一献。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "incense"
          ]
        }
      },
      {
        "id": "second-offering",
        "label": "读词再献",
        "note": "第二献配合宣读词文，不以空泛许愿代替祝告。",
        "kind": "text",
        "icon": "scroll",
        "display_note": "宣读词文，行第二献。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "scroll"
          ]
        }
      },
      {
        "id": "set-feast",
        "label": "陈茶果酒馔",
        "note": "《醮说》原列茶、果、酒、馔并言随力丰俭；不同神位用物有别。",
        "kind": "meal",
        "icon": "meal",
        "display_note": "陈设茶、果、酒与馔品。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "tea",
            "fruit",
            "wine",
            "meal"
          ]
        }
      },
      {
        "id": "third-offering",
        "label": "三献送神",
        "note": "完成第三献，依文送神复炉，礼有始终。",
        "kind": "wine",
        "icon": "wine",
        "display_note": "行第三献，送神复炉。",
        "scene": {
          "enabled": false,
          "reason": "三献送神复炉无独立实体，不凭原 wine 图标推定酒供。"
        }
      }
    ]
  },
  {
    "id": "buddhist-scriptural",
    "label": "佛典供养摘要",
    "note": "依据汉译佛典所列香、华、灯明、饮食及赞叹瞻礼等供养类别编排；不是压缩寺院法会。",
    "sources": [
      {
        "title": "《妙法莲华经·法师品》",
        "locator": "大正藏 T09 No.262：华香、璎珞、末香、涂香、烧香、缯盖、幢幡、衣服、伎乐，合掌恭敬",
        "url": "https://siddham.net/download/sutra/pdf/T09/T09n0262.pdf"
      },
      {
        "title": "《地藏菩萨本愿经》",
        "locator": "大正藏 T13 No.412：香华、衣服、饮食、净水、赞叹瞻礼等供养记载",
        "url": "https://dlbs.liberal.ntu.edu.tw/BDLM/sutra/html/T13/T13n0412.htm"
      }
    ],
    "steps": [
      {
        "id": "compose",
        "label": "正身合掌",
        "note": "先摄身心，以合掌恭敬进入供养。",
        "kind": "reverence",
        "icon": "hand",
        "display_note": "正身合掌，收摄身心。",
        "scene": {
          "enabled": false,
          "reason": "正身合掌是身体姿态与摄心，不是供物。"
        }
      },
      {
        "id": "flower",
        "label": "献华",
        "note": "经文所见“华香”供养之一，不规定现代花材与数量。",
        "kind": "flower",
        "icon": "flower",
        "display_note": "献花供养，表达敬意。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "flower"
          ]
        }
      },
      {
        "id": "incense",
        "label": "烧香",
        "note": "佛典区分末香、涂香、烧香等，这里仅以烧香作界面代表。",
        "kind": "incense",
        "icon": "flame",
        "display_note": "焚香供养，恭敬行礼。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "incense"
          ]
        }
      },
      {
        "id": "lamp",
        "label": "燃灯明",
        "note": "灯明供养见于佛典；页面只作象征呈现。",
        "kind": "lamp",
        "icon": "lamp",
        "display_note": "点亮供灯。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "lamp"
          ]
        }
      },
      {
        "id": "food",
        "label": "陈饮食",
        "note": "经文称饮食供养；不据现代网络说法补造固定果数和摆位。",
        "kind": "meal",
        "icon": "meal",
        "display_note": "陈设饮食，表达供养之意。",
        "scene": {
          "enabled": true,
          "action": "offer",
          "assets": [
            "meal"
          ]
        }
      },
      {
        "id": "praise",
        "label": "赞叹瞻礼",
        "note": "以赞叹、瞻礼收束；不替代寺院的专门法会仪轨。",
        "kind": "reverence",
        "icon": "sparkles",
        "display_note": "赞叹瞻礼，以敬意收束。",
        "scene": {
          "enabled": false,
          "reason": "赞叹瞻礼没有独立物件，不以星光占位。"
        }
      }
    ]
  },
  {
    "id": "state-ritual-classical",
    "label": "古代祀典摘要",
